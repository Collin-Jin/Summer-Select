# Supabase project credentials (get these from your Supabase project settings)
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_KEY=<your-supabase-publishable-key>

# Your deployed app origin — used to build password-reset redirect URLs.
# For local development, leave as http://localhost:3000.
# For production, set to your real domain (e.g. https://www.summerselect.com).
NEXT_PUBLIC_APP_URL=http://localhost:3000
