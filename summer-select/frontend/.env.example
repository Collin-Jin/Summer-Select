# Copy to .env.local and fill in. Never commit real values.

# Supabase project (Dashboard -> Project Settings -> API).
# Use the publishable/anon key only. The service_role key must never be used here.
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_KEY=<your-supabase-publishable-key>

# Origin of the deployed app, used to build auth e-mail redirect URLs.
# Leave as-is for local development; set to your real domain in production.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only. Used by the essay evaluator and by the admin tools to embed
# reference essays. Required for /dashboard/evaluate and AI reference essays.
OPENAI_API_KEY=<your-openai-api-key>
